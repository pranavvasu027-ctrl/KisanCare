# ==============================================================================
# KisanCare Environment Configuration Template
# Copy this file to .env and configure the appropriate values for your environment.
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Database & Supabase (PostgreSQL 15 + PostGIS)
# Required for user authentication, farm digital twin state, and field boundaries.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# Backend Gateway (FastAPI - Port 8000)
ML_SERVICE_URL=http://localhost:8001
ML_SERVICE_TIMEOUT_SECONDS=8
ML_MOCK_FALLBACK_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=120
RATELIMIT_STORAGE_URL=memory://

# AI Copilot (LLM Assistant)
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# External Agricultural Data APIs (Optional / Ingestion scripts)
# Data.gov.in API key for live Agmarknet mandi arrivals
DATA_GOV_IN_API_KEY=your-data-gov-in-api-key
# External Meteorological & Weather Providers (Pluggable: open-meteo, weatherapi)
# Default development provider is Open-Meteo.
WEATHER_PROVIDER=open-meteo
# Commercial Open-Meteo subscription key (leave unset in development for free tier)
OPEN_METEO_API_KEY=your-open-meteo-commercial-api-key
# Set to true in commercial production to route requests to customer-api.open-meteo.com
WEATHER_COMMERCIAL_MODE=false
# Alternative provider: WeatherAPI.com (if WEATHER_PROVIDER=weatherapi)
WEATHERAPI_KEY=your-weatherapi-key
# Weather cache duration (default 900s / 15 minutes fresh, up to 7200s / 2h stale degraded)
WEATHER_CACHE_TTL_SECONDS=900
WEATHER_CACHE_MAX_STALE_SECONDS=7200

# OpenWeather API key (legacy/ingestion)
OPENWEATHER_API_KEY=your-openweather-api-key

# Standalone Irrigation & Yield Service (Port 8002 / services/irrigation_yield_api)
API_HOST=0.0.0.0
API_PORT=8002
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CROP_YIELD_REPO_ID=NIHAL670/Crop-yield
HF_TOKEN=your-huggingface-token-optional

# Frontend Development (Vite - Port 5173)
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
VITE_DEMO_MODE=false
