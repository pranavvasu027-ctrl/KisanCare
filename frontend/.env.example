# Set to true only for local demos and UI development without Supabase.
# This bypasses the frontend route guard; it is not authentication or authorization.
VITE_DEMO_MODE=false

# Backend API proxy target (Defaults to http://localhost:8000)
VITE_API_BASE_URL=http://localhost:8000

# Required when demo mode is false. Use only the public Supabase project URL
# and anonymous/publishable key. Never place a service-role key here.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Google Maps Platform API Key (Optional: for Google Maps JavaScript API/Directions API; defaults to Leaflet + Google Maps URL intents)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
