# Set to true only for local demos and UI development. This bypasses the
# frontend route guard; it is not authentication or authorization.
VITE_DEMO_MODE=false

# Required when demo mode is false. Use only the public Supabase project URL
# and anonymous/publishable key. Never place a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
